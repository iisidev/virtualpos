# ==========================================
# CORP-CREDIT POS - Variables del stack (Portainer: "Load variables from .env file")
# Copie este archivo a .env, complete TODOS los valores y suba el .env a Portainer.
# No se usan valores por defecto: si falta una variable el stack no inicia.
# ==========================================

# Puertos externos del host
WEB_PORT=
API_PORT=
OPENCLAW_PORT=
DB_PORT=
REDIS_PORT=

# PostgreSQL
DB_USER=
DB_PASSWORD=
DB_NAME=

# Redis
REDIS_PASSWORD=

# Seguridad (JWT_SECRET: cadena aleatoria larga; SALARY_ENCRYPTION_KEY: 64 hex, ej. `openssl rand -hex 32`)
JWT_SECRET=
SALARY_ENCRYPTION_KEY=

# Administrador inicial (se crea solo si no existe; ADMIN_RESET_PASSWORD=true fuerza restablecer su clave)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=false

# WhatsApp / OpenClaw
WHATSAPP_BOT_NUMBER=
WHATSAPP_VERIFY_TOKEN=
OPENCLAW_GATEWAY_TOKEN=
# Orígenes permitidos de la interfaz de OpenClaw, separados por coma (ej. http://host:puerto,http://otro:puerto)
OPENCLAW_ALLOWED_ORIGINS=
# URL interna de la API vista desde OpenClaw (ej. http://api:3000/api/v1)
POS_API_URL=
# Clave que usa OpenClaw para llamar a /agent/* de la API
AGENT_API_KEY=