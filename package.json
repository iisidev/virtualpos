{
  "name": "corp-credit-pos-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Corp-Credit POS - Sistema Web Transaccional de Gestión de Créditos Corporativos y POS Virtual Multi-Empresa",
  "scripts": {
    "api:start": "npm --prefix apps/api run start:dev",
    "api:build": "npm --prefix apps/api run build",
    "api:test": "npm --prefix apps/api test",
    "web:start": "npm --prefix apps/web start",
    "web:build": "npm --prefix apps/web run build",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  },
  "keywords": [
    "pos",
    "credit-ledger",
    "corporate-credit",
    "nestjs",
    "angular",
    "typeorm",
    "postgresql",
    "redis",
    "ollama",
    "whatsapp"
  ],
